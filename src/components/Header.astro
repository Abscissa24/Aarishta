---
import ThemeToggle from "./ThemeToggle.astro";
import ListenToggle from "./ListenToggle.astro";
import ReducedMotionToggle from "./ReducedMotionToggle.astro";
import { SITE, LINKS } from "@/consts";
---

<header
  id="header"
  class="fixed top-0 z-50 hidden h-16 w-full md:block print:hidden"
  transition:persist
  transition:name="site-header"
>
  <div class="container mx-auto h-full">
    <div class="relative flex h-full items-center justify-between">
      {/* Logo/Title */}
      <a
        href={import.meta.env.BASE_URL}
        class="font-bold uppercase text-black/80 duration-300 hover:text-black hover:transition-colors dark:text-white/80 dark:hover:text-white"
      >
        {SITE.TITLE}
      </a>

      {/* Navigation */}
      <nav class="hidden items-center gap-6 text-sm md:flex">
        {
          LINKS.map((LINK) => (
            <a
              href={LINK.HREF}
              data-href={LINK.HREF}
              class="flex h-8 items-center justify-center rounded-full px-3 duration-300 hover:transition-colors"
            >
              {LINK.TEXT}
            </a>
          ))
        }
      </nav>

      {/* Icons and Toggles */}
      <div class="flex gap-2">
        <ListenToggle id="headerListenToggle" />
        <ThemeToggle id="headerThemeToggle" />
        <ReducedMotionToggle id="headerReducedMotionToggle" />
      </div>
    </div>
  </div>
</header>

<script>
  // `scroll` can fire dozens of times per second. Reading window.scrollY
  // and touching the DOM directly in that handler means the class gets
  // toggled far more often than the browser can actually paint, and
  // does so straight off the scroll event rather than in step with a
  // frame - both add unnecessary main-thread work while scrolling,
  // which is exactly when it's most likely to be felt as jank
  // elsewhere (e.g. the starry field or a nav click). Coalescing to
  // one check per animation frame (and skipping the DOM write when the
  // state hasn't actually changed) keeps this to the minimum work
  // needed.
  let scrollRafId: number | null = null;
  let isScrolled = false;

  function applyScrollState() {
    scrollRafId = null;
    const header = document.getElementById("header");
    if (!header) return;
    const scrolled = window.scrollY > 0;
    if (scrolled === isScrolled) return;
    isScrolled = scrolled;
    header.classList.toggle("scrolled", scrolled);
  }

  function handleScroll() {
    if (scrollRafId !== null) return;
    scrollRafId = requestAnimationFrame(applyScrollState);
  }

  function setupScrollHandler() {
    window.removeEventListener("scroll", handleScroll);
    window.addEventListener("scroll", handleScroll, { passive: true });
    isScrolled = false;
    applyScrollState();
  }
  setupScrollHandler();

  // The header now persists across client-side navigation
  // (transition:persist), so its nav links are only rendered
  // server-side once and won't get fresh "is this the active page"
  // classes on every route change - update them here instead, driven
  // by the current URL, matching the same "/" + firstSegment fallback
  // the old server-side check used (so e.g. a future /projects/[id]
  // subpage still highlights "Projects").
  function updateActiveLink() {
    const path = window.location.pathname;
    const firstSegment = "/" + (path.match(/[^/]+/g)?.[0] ?? "");
    document.querySelectorAll("#header nav a[data-href]").forEach((el) => {
      const href = el.getAttribute("data-href");
      const isActive = path === href || firstSegment === href;
      el.classList.toggle("active", isActive);
    });
  }
  updateActiveLink();

  document.addEventListener("astro:after-swap", setupScrollHandler);
  document.addEventListener("astro:after-swap", updateActiveLink);
</script>

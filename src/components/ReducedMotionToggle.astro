---
import { Icon } from "astro-icon/components";
import { cn } from "@/lib/utils";

type Props = {
  id: string;
};

const { id } = Astro.props;
---

<button
  id={id}
  aria-label="Toggle reduced motion"
  class={cn(
    "flex",
    "size-9 rounded-full p-2 items-center justify-center",
    "text-black/80 dark:text-white/80",
    "bg-transparent hover:bg-black/20 dark:hover:bg-white/20",
    "stroke-current hover:stroke-black hover:dark:stroke-white",
    "border border-black/25 dark:border-white/25",
    "hover:transition-colors duration-300",
  )}
>
  <Icon name="motion" class="block size-full rm:hidden" />
  <Icon name="motion-off" class="hidden size-full rm:block" />
</button>

<script is:inline define:vars={{ id }}>
  const setReducedMotionToggleListener = () => {
    const toggleBtn = document.getElementById(id);
    // The header/navbar this lives in now persist across client-side
    // navigation (transition:persist), so this same button element is
    // never recreated - only re-run through this setup function again
    // on every astro:after-swap. Without this guard, that would attach
    // a second (third, fourth...) click listener to the same
    // never-removed element instead of just re-binding a fresh one.
    if (!toggleBtn || toggleBtn.dataset.bound === "true") return;
    toggleBtn.dataset.bound = "true";

    const handleToggleClick = () => {
      const element = document.documentElement;
      element.classList.toggle("reduce-motion");

      const isReduced = element.classList.contains("reduce-motion");
      localStorage.setItem("reducedMotion", isReduced ? "true" : "false");
    };

    toggleBtn.addEventListener("click", handleToggleClick);
  };

  setReducedMotionToggleListener();

  document.addEventListener("astro:after-swap", setReducedMotionToggleListener);
</script>

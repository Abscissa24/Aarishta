---
import Section from "./Section.astro";
import { certificates } from "@cv";
---

<Section className={Astro.props.className} title="Certificates">
  <ul class="space-y-4">
    {
      certificates.map(({ name, issuer, date, number, grade, points, expires }) => {
        const year = new Date(date).getFullYear();

        return (
          <li class="flex flex-col md:flex-row md:items-baseline">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="mr-2 hidden h-5 w-5 md:inline-block"
            >
              <circle cx="12" cy="8" r="6" />
              <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11" />
            </svg>
            <div class="relative w-full">
              <time class="mb-1 text-xs font-bold text-black/50 dark:text-white/50 md:absolute md:right-0 md:top-0">
                {year}
              </time>
              <div class="text-base font-medium leading-snug text-black dark:text-white">
                {name}
              </div>
              <p class="mt-1 text-sm text-black/80 dark:text-white/80">{issuer}</p>
              {(number || grade || points || expires) && (
                <div class="mt-2 text-sm">
                  <ul class="list-inside list-disc space-y-1 text-black/50 dark:text-white/50">
                    {number && <li>Certificate Number: {number}</li>}
                    {grade && <li>Grade: {grade}</li>}
                    {points && <li>{points}</li>}
                    {expires && <li>Expires: {expires}</li>}
                  </ul>
                </div>
              )}
            </div>
          </li>
        );
      })
    }
  </ul>
</Section>